@page
@model AlgoPlayground.Pages.Game.MatchingPairs.IndexModel
@{
    ViewData["Title"] = "Matching Pairs";
}
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h4">Matching Pairs – Relations &amp; Functions</h1>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <label class="form-label mb-0">Mode</label>
                    <select id="pairsMode" class="form-select w-auto">
                        <option value="relation">Relation</option>
                        <option value="function">Function</option>
                    </select>
                    <button class="btn btn-primary" id="pairsStartBtn">Start Round</button>
                    <button class="btn btn-outline-danger" id="pairsResetBtn">Reset</button>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <h2 class="h6">Domain</h2>
                        <div id="pairsDomain" class="pairs-board"></div>
                    </div>
                    <div class="col-md-6">
                        <h2 class="h6">Codomain</h2>
                        <div id="pairsCodomain" class="pairs-board"></div>
                    </div>
                </div>
                <div class="mt-3">
                    <h2 class="h6">Pairs</h2>
                    <ul id="pairsList" class="list-group"></ul>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h2 class="h5">Stats</h2>
                <dl class="row mb-0">
                    <dt class="col-6">Level</dt><dd class="col-6" id="pairsLevel">1</dd>
                    <dt class="col-6">Time</dt><dd class="col-6" id="pairsTimer">0s</dd>
                    <dt class="col-6">Attempts</dt><dd class="col-6" id="pairsAttempts">0</dd>
                    <dt class="col-6">Valid</dt><dd class="col-6" id="pairsValid">0</dd>
                    <dt class="col-6">Accuracy</dt><dd class="col-6" id="pairsAccuracy">0%</dd>
                    <dt class="col-6">Score</dt><dd class="col-6" id="pairsScore">0</dd>
                </dl>
            </div>
        </div>
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">Help</h2>
                <p>Select a domain item then a codomain item. Function mode enforces one mapping per domain. Accuracy is valid pairs divided by attempts.</p>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/common.js"></script>
    <script src="~/js/pairs.js"></script>
}
