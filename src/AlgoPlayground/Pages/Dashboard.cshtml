@page
@model AlgoPlayground.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3">Welcome back, @Model.Profile?.Name!</h1>
        <p class="text-muted">Ready to tackle discrete math through games? Choose one below.</p>
    </div>
    <div class="text-end">
        <span class="badge bg-primary fs-6">ID #@Model.Profile?.StudentNumber</span>
    </div>
</div>
<div class="row g-4">
@foreach (var card in Model.GameCards)
{
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h2 class="h5">@card.Title</h2>
                <p class="text-muted flex-grow-1">@card.Description</p>
                <div class="mb-3">
                    <span class="fw-bold">Last Score:</span>
                    @if (card.LastScore != null)
                    {
                        <div>@card.LastScore.Points pts • Level @card.LastScore.Level</div>
                        <small class="text-muted">@card.LastScore.Timestamp.ToLocalTime().ToString("g")</small>
                    }
                    else
                    {
                        <span class="text-muted">No score yet</span>
                    }
                </div>
                <a class="btn btn-outline-primary mt-auto" asp-page="@card.Page">Play</a>
            </div>
        </div>
    </div>
}
</div>
