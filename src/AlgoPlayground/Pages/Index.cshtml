@page
@model AlgoPlayground.Pages.IndexModel
@{
    ViewData["Title"] = "Welcome";
}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h3 mb-3">Create Your Profile</h1>
                <p class="text-muted">Enter your details to begin exploring the AlgoPlayground.</p>
                <form method="post" novalidate>
                    <div class="mb-3">
                        <label asp-for="Input.Name" class="form-label"></label>
                        <input asp-for="Input.Name" class="form-control" />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.StudentNumber" class="form-label"></label>
                        <input asp-for="Input.StudentNumber" class="form-control" />
                        <span asp-validation-for="Input.StudentNumber" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Continue to Dashboard</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
